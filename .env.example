# Authentication (server-only)
# Local PostgreSQL started by pnpm db:start; use a dedicated hosted database in production.
DATABASE_URL=postgresql://coffee_timer:coffee_timer_dev@localhost:5433/coffee_timer
# Generate a different secret for each environment with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production must use its canonical HTTPS origin.
BETTER_AUTH_URL=http://localhost:3009

# Meticulous session recorder — https://app.meticulous.ai/docs/recorder-installation
# Project ID: Meticulous Dashboard → Project Settings
NEXT_PUBLIC_METICULOUS_PROJECT_ID=

# GitHub Actions only (Repository Settings → Secrets → Actions)
# METICULOUS_API_TOKEN=
